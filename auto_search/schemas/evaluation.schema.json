{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluations", "ranking", "portfolio_assessment"],
  "properties": {
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_id",
          "idea_title",
          "verdict",
          "scores",
          "strengths",
          "major_risks",
          "required_revisions",
          "rejection_reason",
          "literature_overlap_risk"
        ],
        "properties": {
          "paper_id": {"type": "string", "minLength": 1},
          "idea_title": {"type": "string", "minLength": 1},
          "verdict": {"type": "string", "enum": ["strong", "promising", "weak", "pass"]},
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "problem_grounding",
              "root_cause_quality",
              "point_to_point_alignment",
              "terminology_discipline",
              "novelty_plausibility",
              "implementation_feasibility",
              "benchmark_readiness",
              "resource_feasibility",
              "annotation_compliance",
              "validation_strength",
              "contribution_clarity"
            ],
            "properties": {
              "problem_grounding": {"type": "integer", "minimum": 1, "maximum": 5},
              "root_cause_quality": {"type": "integer", "minimum": 1, "maximum": 5},
              "point_to_point_alignment": {"type": "integer", "minimum": 1, "maximum": 5},
              "terminology_discipline": {"type": "integer", "minimum": 1, "maximum": 5},
              "novelty_plausibility": {"type": "integer", "minimum": 1, "maximum": 5},
              "implementation_feasibility": {"type": "integer", "minimum": 1, "maximum": 5},
              "benchmark_readiness": {"type": "integer", "minimum": 1, "maximum": 5},
              "resource_feasibility": {"type": "integer", "minimum": 1, "maximum": 5},
              "annotation_compliance": {"type": "integer", "minimum": 1, "maximum": 5},
              "validation_strength": {"type": "integer", "minimum": 1, "maximum": 5},
              "contribution_clarity": {"type": "integer", "minimum": 1, "maximum": 5}
            }
          },
          "strengths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "major_risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required_revisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rejection_reason": {"type": "string", "minLength": 1},
          "literature_overlap_risk": {"type": "string", "minLength": 1}
        }
      }
    },
    "ranking": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "portfolio_assessment": {"type": "string", "minLength": 1}
  }
}
