{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["subsections"],
  "properties": {
    "subsections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "scope",
          "connection_to_paper",
          "search_queries"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 3 },
          "scope": { "type": "string", "minLength": 20 },
          "connection_to_paper": { "type": "string", "minLength": 20 },
          "search_queries": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 4 }
          }
        }
      }
    }
  }
}
