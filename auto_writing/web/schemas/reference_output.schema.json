{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "references",
    "bibtex",
    "updated_sections",
    "coverage",
    "evidence_boundaries"
  ],
  "properties": {
    "references": {
      "type": "array",
      "minItems": 20,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_key",
          "title",
          "authors",
          "year",
          "venue",
          "doi",
          "source_url",
          "bibtex",
          "used_in"
        ],
        "properties": {
          "citation_key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9:_-]{2,79}$" },
          "title": { "type": "string", "minLength": 5 },
          "authors": { "type": "string", "minLength": 2 },
          "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
          "venue": { "type": "string", "minLength": 2 },
          "doi": { "type": "string" },
          "source_url": { "type": "string", "minLength": 8 },
          "bibtex": { "type": "string", "minLength": 40 },
          "used_in": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "intro_p1",
                "intro_p2",
                "related_work",
                "experiments_datasets",
                "experiments_backbones",
                "experiments_baselines"
              ]
            }
          }
        }
      }
    },
    "bibtex": { "type": "string", "minLength": 500 },
    "updated_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intro", "related_work", "experiments"],
      "properties": {
        "intro": { "type": "string", "minLength": 80 },
        "related_work": { "type": "string", "minLength": 80 },
        "experiments": { "type": "string", "minLength": 80 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro_p1",
        "intro_p2",
        "related_work",
        "experiments_datasets",
        "experiments_backbones",
        "experiments_baselines"
      ],
      "properties": {
        "intro_p1": { "$ref": "#/definitions/citationKeys" },
        "intro_p2": { "$ref": "#/definitions/citationKeys" },
        "related_work": { "$ref": "#/definitions/citationKeys" },
        "experiments_datasets": { "$ref": "#/definitions/targetCoverage" },
        "experiments_backbones": { "$ref": "#/definitions/targetCoverage" },
        "experiments_baselines": { "$ref": "#/definitions/targetCoverage" }
      }
    },
    "evidence_boundaries": {
      "type": "array",
      "items": { "type": "string", "minLength": 8 }
    }
  },
  "definitions": {
    "citationKeys": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9:_-]{2,79}$" }
    },
    "targetCoverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "citation_keys"],
        "properties": {
          "target": { "type": "string", "minLength": 2 },
          "citation_keys": { "$ref": "#/definitions/citationKeys" }
        }
      }
    }
  }
}
