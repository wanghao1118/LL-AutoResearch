+def _rule_hits(text: str, rules: dict[str, tuple[str, ...]]) -> dict[str, list[str]]:
+    hits: dict[str, list[str]] = {}
+    for label, phrases in rules.items():
+        matched = [phrase for phrase in phrases if _normalize(phrase) in text]
+        if matched:
+            hits[label] = matched
+    return hits
