+BACKGROUND_TASK_MARKERS = (
+    "previous work",
+    "previous approaches",
+    "recent approaches",
+    "existing approaches",
+    "was shown",
+    "were shown",
+    "broad set of tasks",
+)
+
+OWN_TASK_MARKERS = (
+    "we evaluate",
+    "we evaluated",
+    "we study",
+    "we consider",
+    "we focus",
+    "we demonstrate",
+    "we showcase",
+    "we illustrate",
+    "our experiments",
+    "our method",
+    "our framework",
+    "method_x",
+    "applications of",
+)
