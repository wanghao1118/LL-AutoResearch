+        if sentence_counts:
+            candidates.append((min(sum(sentence_counts), 50), sentence.strip()))
+    if not candidates:
+        return 0, []
+    breadth = max(count for count, _ in candidates)
+    evidence = sorted({sentence for count, sentence in candidates if count == breadth})
+    return breadth, evidence
