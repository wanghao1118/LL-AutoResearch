+def _normalize(text: str) -> str:
+    text = text.casefold().replace("–", "-").replace("—", "-")
+    text = re.sub(r"(?<=[a-z0-9])-(?=[a-z0-9])", " ", text)
+    return re.sub(r"\s+", " ", text)
