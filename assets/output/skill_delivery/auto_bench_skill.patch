+EVALUATION_OWNERSHIP_MARKERS = (
+    "we evaluate",
+    "we evaluated",
+    "to evaluate",
+    "we conduct experiments",
+    "we conducted experiments",
+    "we demonstrate",
+    "we show",
+    "our experiments",
+    "comprehensive testing",
+)
