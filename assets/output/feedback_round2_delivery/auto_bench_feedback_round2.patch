+def load_human_gate_state(
+    relative_root: str,
+    *,
+    workspace_root: Path | None = None,
+) -> tuple[dict[str, Any], str]:
+    """Return the current audit's final verdict, or its pending state.
+
+    A completed verdict may coexist with the original pending record so the
+    pre-review state remains reproducible. The audit ID prevents an older
+    verdict from completing a newly generated review round.
+    """
+
+    root = workspace_root or ROOT
+    audit_path = root / relative_root / "literature_audit.json"
+    pending_path = root / relative_root / "pending_verdict.json"
+    final_path = root / relative_root / "final_verdict.json"
+    audit = json.loads(audit_path.read_text(encoding="utf-8"))
+    if final_path.is_file():
+        final = json.loads(final_path.read_text(encoding="utf-8"))
+        if final.get("audit_id") == audit.get("audit_id"):
+            return final, str(final_path.relative_to(root))
+    pending = json.loads(pending_path.read_text(encoding="utf-8"))
+    return pending, str(pending_path.relative_to(root))
+
+
+def determine_completion_status(
+    *,
+    machine_ready: bool,
+    human_validation_complete: bool,
+    human_validation_passed: bool,
+) -> str:
+    """Separate missing reviews from completed reviews that expose quality gaps."""
+
+    if not machine_ready:
+        return "MACHINE_WORKFLOW_NEEDS_ITERATION"
+    if not human_validation_complete:
+        return "MACHINE_WORKFLOW_READY_HUMAN_GATES_PENDING"
+    if not human_validation_passed:
+        return "HUMAN_VALIDATION_NEEDS_ITERATION"
+    return "COMPLETE"
